---
interface Props {
  brandHref: string
  catalogHref: string
}

const { brandHref, catalogHref } = Astro.props
---

<header class="site-header">
  <a class="brand" href={brandHref} aria-label="Bicycle Monkey Rent">
    <span>🐒🚲</span>
    <strong>Bicycle Monkey Rent</strong>
  </a>
  <nav aria-label="Основная навигация">
    <a href="#flow">Сценарий квеста</a>
    <a href="#roles">Волшебные роли</a>
    <a href="#safety">Безопасность</a>
    <a href={catalogHref}>Каталог</a>
  </nav>
</header>
