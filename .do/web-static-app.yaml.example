name: bicycle-rent-web
region: fra
alerts:
  - rule: DEPLOYMENT_FAILED
  - rule: DOMAIN_FAILED
static_sites:
  - name: web
    github:
      repo: di-sukharev/monkey_bikes
      branch: master
      deploy_on_push: true
    source_dir: /
    environment_slug: node-js
    build_command: bun install --frozen-lockfile && bun run build:web
    output_dir: web/dist
    index_document: index.html
    catchall_document: index.html
    envs:
      - key: VITE_API_URL
        value: https://REPLACE_WITH_BACKEND_DEFAULT_INGRESS
        scope: BUILD_TIME
        type: GENERAL
