name: bicycle-rent-api
region: fra
alerts:
  - rule: DEPLOYMENT_FAILED
  - rule: DOMAIN_FAILED
databases:
  - name: bicycle-rent-db
    engine: PG
    production: true
    cluster_name: bicycle-rent-pg
    db_name: defaultdb
    db_user: doadmin
services:
  - name: api
    github:
      repo: di-sukharev/monkey_bikes
      branch: master
      deploy_on_push: true
    source_dir: /
    dockerfile_path: backend/Dockerfile
    http_port: 8080
    instance_count: 1
    health_check:
      http_path: /health
      initial_delay_seconds: 10
      period_seconds: 10
      timeout_seconds: 5
      success_threshold: 1
      failure_threshold: 5
    liveness_health_check:
      http_path: /health
      initial_delay_seconds: 30
      period_seconds: 10
      timeout_seconds: 5
      success_threshold: 1
      failure_threshold: 5
    envs:
      - key: APP_ENV
        value: production
        scope: RUN_TIME
        type: GENERAL
      - key: DATABASE_URL
        value: ${bicycle-rent-db.DATABASE_URL}
        scope: RUN_TIME
        type: SECRET
      - key: JWT_SECRET
        value: REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS
        scope: RUN_TIME
        type: SECRET
      - key: CORS_ORIGINS
        value: https://REPLACE_WITH_WEB_DEFAULT_INGRESS
        scope: RUN_TIME
        type: GENERAL
      - key: ACCESS_TOKEN_TTL_SECONDS
        value: "900"
        scope: RUN_TIME
        type: GENERAL
      - key: REFRESH_TOKEN_TTL_DAYS
        value: "30"
        scope: RUN_TIME
        type: GENERAL
      - key: COOKIE_SECURE
        value: "true"
        scope: RUN_TIME
        type: GENERAL
      - key: PAYMENT_PROVIDER
        value: stub
        scope: RUN_TIME
        type: GENERAL
      - key: PAYMENT_STUB_DEV_ENDPOINTS_ENABLED
        value: "false"
        scope: RUN_TIME
        type: GENERAL
      - key: PAYMENT_CURRENCY
        value: RUB
        scope: RUN_TIME
        type: GENERAL
jobs:
  - name: migrate
    kind: PRE_DEPLOY
    github:
      repo: di-sukharev/monkey_bikes
      branch: master
      deploy_on_push: true
    source_dir: /
    dockerfile_path: backend/Dockerfile
    run_command: bun run prisma:deploy
    instance_count: 1
    envs:
      - key: APP_ENV
        value: production
        scope: RUN_TIME
        type: GENERAL
      - key: DATABASE_URL
        value: ${bicycle-rent-db.DATABASE_URL}
        scope: RUN_TIME
        type: SECRET
