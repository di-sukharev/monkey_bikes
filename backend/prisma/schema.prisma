generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  manufacturer
  user

  @@map("user_role")
}

enum UserStatus {
  active
  blocked

  @@map("user_status")
}

enum ManufacturerProfileStatus {
  approved
  blocked
  draft
  moderation
  rejected

  @@map("manufacturer_profile_status")
}

enum BicycleSize {
  S
  M
  L

  @@map("bicycle_size")
}

enum BicycleStatus {
  archived
  available
  draft
  hidden
  maintenance
  moderation
  rejected
  rented
  reserved

  @@map("bicycle_status")
}

enum FulfillmentType {
  delivery
  pickup

  @@map("fulfillment_type")
}

enum OrderStatus {
  cancelled
  confirmed
  issued
  request
  returned

  @@map("order_status")
}

enum PaymentType {
  deposit
  rent

  @@map("payment_type")
}

enum PaymentProvider {
  stub

  @@map("payment_provider")
}

enum PaymentStatus {
  cancelled
  failed
  pending
  succeeded

  @@map("payment_status")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  displayName         String?
  role                UserRole             @default(user)
  status              UserStatus           @default(active)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            AuthSession[]
  manufacturerProfile ManufacturerProfile?
  orders              Order[]
  orderStatusHistory  OrderStatusHistory[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model ManufacturerProfile {
  id                String                    @id @default(cuid())
  userId            String                    @unique
  legalName         String
  publicName        String
  region            String?
  city              String
  phone             String
  email             String
  description       String
  status            ManufacturerProfileStatus @default(draft)
  moderationComment String?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bicycles          Bicycle[]

  @@index([status])
  @@index([createdAt])
  @@map("manufacturer_profiles")
}

model Bicycle {
  id                          String              @id @default(cuid())
  manufacturerProfileId       String
  title                       String
  description                 String
  size                        BicycleSize
  photoUrls                   String[]            @default([])
  pricePerDayKopecks          Int
  depositKopecks              Int
  status                      BicycleStatus       @default(draft)
  moderationComment           String?
  submittedAt                 DateTime?
  reviewedAt                  DateTime?
  region                      String?
  city                        String
  pickupAddress               String
  deliveryAvailable           Boolean             @default(false)
  maxLoadKg                   Int
  seatHeightCm                Int
  frameLengthCm               Int
  wheelDiameterCm             Int
  recommendedAnimalDimensions String
  safetyNotes                 String
  availabilityLockVersion     Int                 @default(0)
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  manufacturerProfile         ManufacturerProfile @relation(fields: [manufacturerProfileId], references: [id], onDelete: Restrict)
  orderItems                  OrderItem[]

  @@index([manufacturerProfileId, createdAt])
  @@index([status, createdAt])
  @@index([size])
  @@index([city])
  @@index([pricePerDayKopecks])
  @@map("bicycles")
}

model Order {
  id                         String          @id @default(cuid())
  userId                     String
  status                     OrderStatus     @default(request)
  startsOn                   String
  endsOn                     String
  rentalDays                 Int
  fulfillmentType            FulfillmentType
  deliveryAddress            String?
  contactName                String
  contactPhone               String
  userComment                String?
  adminComment               String?
  rentalAmountKopecks        Int
  depositAmountKopecks       Int
  deliveryAmountKopecks      Int             @default(0)
  totalAmountKopecks         Int
  safetyAgreementAcceptedAt  DateTime
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  user                       User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  items                      OrderItem[]
  statusHistory              OrderStatusHistory[]
  payments                   Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, startsOn, endsOn])
  @@index([startsOn, endsOn])
  @@map("orders")
}

model OrderItem {
  id                                  String      @id @default(cuid())
  orderId                             String
  bicycleId                           String
  pricePerDaySnapshotKopecks          Int
  depositSnapshotKopecks              Int
  bicycleTitleSnapshot                String
  bicycleSizeSnapshot                 BicycleSize
  bicycleCitySnapshot                 String
  bicyclePickupAddressSnapshot        String
  bicycleDeliveryAvailableSnapshot    Boolean
  manufacturerProfileIdSnapshot       String
  manufacturerPublicNameSnapshot      String
  manufacturerRegionSnapshot          String?
  manufacturerCitySnapshot            String
  createdAt                           DateTime    @default(now())
  order                               Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bicycle                             Bicycle     @relation(fields: [bicycleId], references: [id], onDelete: Restrict)

  @@unique([orderId, bicycleId])
  @@index([bicycleId])
  @@map("order_items")
}

model OrderStatusHistory {
  id              String      @id @default(cuid())
  orderId         String
  fromStatus      OrderStatus
  toStatus        OrderStatus
  changedByUserId String
  comment         String?
  createdAt       DateTime    @default(now())
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser   User        @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([changedByUserId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  type              PaymentType
  provider          PaymentProvider @default(stub)
  status            PaymentStatus   @default(pending)
  amountKopecks     Int
  currency          String          @default("RUB")
  providerPaymentId String?         @unique
  failureReason     String?
  completedAt       DateTime?
  activeKey         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type, activeKey])
  @@index([orderId, type, status])
  @@index([status, createdAt])
  @@map("payments")
}
