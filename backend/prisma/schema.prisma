generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  manufacturer
  user

  @@map("user_role")
}

enum UserStatus {
  active
  blocked

  @@map("user_status")
}

enum ManufacturerProfileStatus {
  approved
  blocked
  draft
  moderation
  rejected

  @@map("manufacturer_profile_status")
}

enum BicycleSize {
  S
  M
  L

  @@map("bicycle_size")
}

enum BicycleStatus {
  archived
  available
  draft
  hidden
  maintenance
  moderation
  rejected
  rented
  reserved

  @@map("bicycle_status")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  displayName         String?
  role                UserRole             @default(user)
  status              UserStatus           @default(active)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            AuthSession[]
  manufacturerProfile ManufacturerProfile?

  @@index([role])
  @@index([status])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model ManufacturerProfile {
  id                String                    @id @default(cuid())
  userId            String                    @unique
  legalName         String
  publicName        String
  region            String?
  city              String
  phone             String
  email             String
  description       String
  status            ManufacturerProfileStatus @default(draft)
  moderationComment String?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bicycles          Bicycle[]

  @@index([status])
  @@index([createdAt])
  @@map("manufacturer_profiles")
}

model Bicycle {
  id                          String              @id @default(cuid())
  manufacturerProfileId       String
  title                       String
  description                 String
  size                        BicycleSize
  photoUrls                   String[]            @default([])
  pricePerDayKopecks          Int
  depositKopecks              Int
  status                      BicycleStatus       @default(draft)
  moderationComment           String?
  submittedAt                 DateTime?
  reviewedAt                  DateTime?
  region                      String?
  city                        String
  pickupAddress               String
  deliveryAvailable           Boolean             @default(false)
  maxLoadKg                   Int
  seatHeightCm                Int
  frameLengthCm               Int
  wheelDiameterCm             Int
  recommendedAnimalDimensions String
  safetyNotes                 String
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  manufacturerProfile         ManufacturerProfile @relation(fields: [manufacturerProfileId], references: [id], onDelete: Restrict)

  @@index([manufacturerProfileId, createdAt])
  @@index([status, createdAt])
  @@index([size])
  @@index([city])
  @@index([pricePerDayKopecks])
  @@map("bicycles")
}
